# ===== Claude (the AI brain) =====
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# claude-haiku-5-5 = cheapest & fastest, claude-sonnet-5-5 = smarter
CLAUDE_MODEL=claude-haiku-5-5

# ===== WhatsApp Cloud API (from developers.facebook.com > your app > WhatsApp > API Setup) =====
WHATSAPP_TOKEN=EAAGxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Any secret word YOU choose. Paste the same word in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=my-secret-verify-word
# App Settings > Basic > App Secret (used to check messages really come from Meta)
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxx
GRAPH_API_VERSION=v21.0

# ===== Business owner =====
# Your WhatsApp number with country code, no + (gets alerts for orders & human handoff)
OWNER_PHONE=919876543210

# ===== Security =====
# Password for the dashboard API. Make it long and random (e.g. 32+ letters/numbers).
# The dashboard asks for it once and sends it as the "x-admin-key" header.
ADMIN_KEY=change-me-to-a-long-random-secret
# Website(s) allowed to call the API from a browser (localhost is always allowed).
# No trailing slash. Separate several with commas.
ALLOWED_ORIGIN=https://future-website-neon.vercel.app

PORT=3000
